{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn thread candidate brief v1",
  "description": "The successful brief projection. brief-check and refusals use the unified access envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "ok", "kind", "brief_version", "source_of_truth", "project",
    "thread", "focus", "limit", "repository_key", "snapshot", "complete",
    "errors", "warnings", "selection", "items"
  ],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "ok": {"type": "boolean", "const": true},
    "kind": {"const": "cairn.hot-context"},
    "brief_version": {"type": "integer", "const": 1},
    "source_of_truth": {"type": "boolean", "const": false},
    "project": {"$ref": "#/$defs/project"},
    "thread": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "focus": {"$ref": "#/$defs/terms"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "repository_key": {"$ref": "#/$defs/sha256"},
    "snapshot": {"$ref": "#/$defs/sha256"},
    "complete": {"type": "boolean"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "matched", "returned", "truncated", "semantic_coverage"],
      "properties": {
        "method": {"const": "literal-focus-v1"},
        "matched": {"type": "integer", "minimum": 0},
        "returned": {"type": "integer", "minimum": 0, "maximum": 50},
        "truncated": {"type": "boolean"},
        "semantic_coverage": {"const": "unknown"}
      }
    },
    "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"}
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "path", "message"],
      "properties": {
        "level": {"enum": ["error", "warning"]},
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "project", "file", "revision", "status", "title", "title_truncated",
        "headline", "headline_truncated", "scope", "scope_truncated", "excluded",
        "excluded_truncated", "overturn", "overturn_truncated", "relevance"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "project": {"$ref": "#/$defs/project"},
        "file": {"type": "string", "pattern": "^projects/"},
        "revision": {"$ref": "#/$defs/sha256"},
        "status": {"const": "valid"},
        "title": {"type": "string", "maxLength": 160},
        "title_truncated": {"type": "boolean"},
        "headline": {"type": "string", "maxLength": 160},
        "headline_truncated": {"type": "boolean"},
        "scope": {"type": "string", "maxLength": 240},
        "scope_truncated": {"type": "boolean"},
        "excluded": {"type": "string", "maxLength": 240},
        "excluded_truncated": {"type": "boolean"},
        "overturn": {"type": "string", "maxLength": 240},
        "overturn_truncated": {"type": "boolean"},
        "relevance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matched_terms", "matched_fields"],
          "properties": {
            "matched_terms": {"$ref": "#/$defs/terms"},
            "matched_fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {"enum": ["id", "title", "decision", "scope"]}
            }
          }
        }
      }
    }
  }
}
